# ============================================================
#  Glitter Store (Next.js) — environment variables
#  Copy to `.env.local` and fill in.
#  NEXT_PUBLIC_* are exposed to the browser — never put secrets here.
# ============================================================

# API base URL (no trailing slash). In production, set this to the
# deployed API URL (e.g. https://glitter-api.onrender.com).
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- Social login (public client IDs) -----------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username   # optional — Telegram login

# --- Maps ---------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token             # optional
