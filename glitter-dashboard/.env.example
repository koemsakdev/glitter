# ============================================================
#  Glitter Dashboard (Next.js) — environment variables
#  Copy to `.env` (or `.env.local`) and fill in.
#  NEXT_PUBLIC_* are exposed to the browser — never put secrets here.
# ============================================================

# API base URL (no trailing slash). In production, set this to the
# deployed API URL (e.g. https://glitter-api.onrender.com).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Maps — address / location picker
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Mapbox — optional map fallback
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
