# ============================================================
#  Glitter API (NestJS) — environment variables
#  Copy this file to `.env` and fill in real values.
#  `.env` is gitignored; this example is safe to commit.
# ============================================================

# --- Database (Neon Postgres) -------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth / JWT ---------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-a-different-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- First-run seed admin (created on boot if missing) ------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=StrongPassw0rd!
SEED_ADMIN_NAME=Super Admin

# --- AI assistant (Google Gemini + Groq fallback) -----------
GOOGLE_API_KEY=your-gemini-api-key
# Free, no-card fallback used when Gemini's quota is exhausted.
# Create a key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# --- Social login verification ------------------------------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token   # optional — only for Telegram login

# --- Email (for email OTP / verification) -------------------
# Option A (works on Render): send from YOUR Gmail via Google Apps Script.
#   Deploy docs/gmail-sender.gs as a web app (see the steps in that file),
#   then set:
# GMAIL_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
# GMAIL_SCRIPT_SECRET=<same random string as SECRET in the script>
# MAIL_FROM_NAME=Glitter Shop
# Option B: any SMTP server (fine locally / on hosts that allow SMTP):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=Glitter Shop <no-reply@example.com>

# --- Server -------------------------------------------------
PORT=5000                                     # hosts (Render/Railway) set this automatically

# --- CORS (production only) ---------------------------------
# When you deploy, list your Vercel domains here (comma-separated).
# Requires the env-driven CORS change in main.ts.
# ALLOWED_ORIGINS=https://glitter-store.vercel.app,https://glitter-dashboard.vercel.app

# Storefront cache refresh (see glitter-store REVALIDATE_SECRET)
STORE_REVALIDATE_URL=http://localhost:3001/api/revalidate
STORE_REVALIDATE_SECRET=change-me

# --- Security log (dashboard sign-ins) --------------------------------------
# Proxies in front of the API that add X-Forwarded-For (Render = 1).
# TRUSTED_PROXY_HOPS=1
# Set to true ONLY if the API is behind Cloudflare.
# TRUST_CLOUDFLARE=false
