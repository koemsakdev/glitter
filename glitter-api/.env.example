# ============================================================
#  Glitter API (NestJS) — environment variables
#  Copy this file to `.env` and fill in real values.
#  `.env` is gitignored; this example is safe to commit.
# ============================================================

# --- Database (Neon Postgres) -------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth / JWT ---------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-a-different-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- First-run seed admin (created on boot if missing) ------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=StrongPassw0rd!
SEED_ADMIN_NAME=Super Admin

# --- AI assistant (Google Gemini) ---------------------------
GOOGLE_API_KEY=your-gemini-api-key

# --- Social login verification ------------------------------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token   # optional — only for Telegram login

# --- Email (SMTP, for email OTP / verification) -------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=Glitter Shop <no-reply@example.com>

# --- Server -------------------------------------------------
PORT=5000                                     # hosts (Render/Railway) set this automatically

# --- CORS (production only) ---------------------------------
# When you deploy, list your Vercel domains here (comma-separated).
# Requires the env-driven CORS change in main.ts.
# ALLOWED_ORIGINS=https://glitter-store.vercel.app,https://glitter-dashboard.vercel.app
